# Copy to /etc/tosbot-ai/tosbot.env only. Never push real values to GitHub.
TELEGRAM_BOT_TOKEN=ISI_TOKEN_BOTFATHER
TELEGRAM_OWNER_ID=0
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_PRIMARY=groq
AI_TIMEOUT=40
TZ=Asia/Jakarta
ADMIN_ALLOWED_SERVICES=
COMPANY_NAME=Perusahaan Anda
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_BANK=
COMPANY_ACCOUNT=
COMPANY_ACCOUNT_NAME=
COMPANY_SIGNER=
COMPANY_CITY=
TOSBOT_OFFER_SIGNATURE_PATH=/opt/tosbot-ai/assets/offer-signature.png

# Group access is opt-in. Members need to @mention the bot in every message.
# Default group behavior: no individual IDs, no privileged shell unless trusted group explicitly enabled.
TELEGRAM_GROUPS_ENABLED=false
# Optional: comma-separated negative Telegram group IDs. Empty = any joined group.
TELEGRAM_ALLOWED_GROUP_IDS=

# Optional group read-only operational tools. Requires a non-empty group allowlist.
TELEGRAM_GROUP_OPERATIONS_ENABLED=false

# DANGEROUS. Allows everyone in the listed groups to run unrestricted root
# commands and business tools without individual verification, by @mention.
# Requires explicit root-owned /etc/tosbot-ai/trusted-groups.json (0600).
TELEGRAM_TRUSTED_GROUP_ADMIN=false
